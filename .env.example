# Copy to .env and fill in.
# Your domain (an A record pointing at the VPS IP), e.g. money.example.com
# Without a domain use  DOMAIN=:80  and  COOKIE_SECURE=false  (HTTP only, less safe).
DOMAIN=money.example.com

# The password you type to sign in. Make it long.
APP_PASSWORD=change-me-to-a-long-password

# Random secret for sign-in sessions. Generate with:  openssl rand -hex 32
SESSION_SECRET=

# Keep true when using a domain (HTTPS).
COOKIE_SECURE=true

# Host ports (change only if 80/443 are already used on the VPS).
HTTP_PORT=80
HTTPS_PORT=443
